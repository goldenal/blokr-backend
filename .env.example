# --- Server ---
# 3003 to avoid colliding with the sibling cribcheck-backend (3001) and the blokr
# frontend's own Next.js dev server (3002).
PORT=3003
NODE_ENV=development
CORS_ORIGIN=*

# --- Database ---
# Local dev (docker-compose Postgres): both point at the same local instance.
# Supabase/managed Postgres swap-in later: DATABASE_URL = pooled connection (port 6543,
# ?pgbouncer=true), DIRECT_URL = direct connection (port 5432). No schema changes needed
# for the swap — just update these two values and run `npx prisma migrate deploy`.
DATABASE_URL="postgresql://blokr:blokr@localhost:5432/blokr?schema=public"
DIRECT_URL="postgresql://blokr:blokr@localhost:5432/blokr?schema=public"


# --- Auth (self-managed JWT) ---
JWT_ACCESS_SECRET=REPLACE_ME_dev_only_access_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=REPLACE_ME_dev_only_refresh_secret
JWT_REFRESH_EXPIRES_IN=30d
BCRYPT_SALT_ROUNDS=10

# --- Paystack (test/sandbox keys for local dev, live keys later) ---
# PAYSTACK_WEBHOOK_SECRET is used to verify the x-paystack-signature HMAC on inbound
# webhooks. Paystack signs webhooks with your account's secret key, so in practice this
# will usually equal PAYSTACK_SECRET_KEY — it's kept as its own var so the two concerns
# (calling the API vs. verifying inbound calls) stay decoupled in config.
PAYSTACK_SECRET_KEY=REPLACE_ME_sk_test
PAYSTACK_PUBLIC_KEY=REPLACE_ME_pk_test
PAYSTACK_WEBHOOK_SECRET=REPLACE_ME_sk_test

# --- Google Calendar OAuth (for 2-way calendar sync integration) ---
GOOGLE_CLIENT_ID=REPLACE_ME_google_client_id
GOOGLE_CLIENT_SECRET=REPLACE_ME_google_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3003/integrations/google-calendar/callback
# Where to redirect the professional's browser back to after the OAuth callback finishes.
FRONTEND_URL=http://localhost:3000

# --- Seed ---
SEED_DEMO_PASSWORD=Passw0rd!

GOOGLE_CLIENT_ID=YOUR_CLIENT_ID_HERE
GOOGLE_CLIENT_SECRET=YOUR_CLIENT_SECRET_HERE
